# pai-backup off-site push configuration.
#
# Copy to /etc/pai-anywhere/backup-offsite.env (mode 0600, root:root) to
# enable off-site upload of the daily age-encrypted snapshot. Without
# this file the script keeps backups local-only.
#
# REMOTE format: <rclone-remote-name>:<bucket-or-path>
# Examples:
#   REMOTE=r2-pai:pai-anywhere-backups/pai-anywhere   # Cloudflare R2 (recommended)
#   REMOTE=b2-pai:my-bucket/pai-anywhere              # Backblaze B2
#   REMOTE=s3-pai:my-bucket/pai-anywhere              # generic S3
#
# Recommended rclone setup (per docs/HARDENING.md "Encrypted Backups"):
#   - Dedicated bucket for pai-anywhere snapshots
#   - Dedicated, bucket-scoped API token (Object Read+Write)
#   - Per-service rclone config at /etc/pai-anywhere/rclone.conf
#     (root:root 0600), so service credentials never live in
#     ~/.config/rclone/rclone.conf
#   - No double encryption (the .tar.age is already age-encrypted)
#
# Export RCLONE_CONFIG below so it reaches the rclone subprocess that
# pai-backup spawns. pai-backup only `source`s this file; export is
# what makes the variable visible to children.

#REMOTE=r2-pai:pai-anywhere-backups/pai-anywhere
#export RCLONE_CONFIG=/etc/pai-anywhere/rclone.conf
